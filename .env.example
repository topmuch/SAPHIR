# ── Base de données ──────────────────────────────────────────────────
# SQLite dans le volume persistant du conteneur (dossier /app/data).
# Dans Coolify : laissez cette valeur par défaut et montez un volume
# sur /app/data (voir README.md).
DATABASE_URL=file:/app/data/saphir.db

# ── Authentification (compte admin créé au premier démarrage) ────────
# ADMIN_EMAIL=admin@saphircom.ma
# ADMIN_PASSWORD=Admin2026
# AUTH_SECRET=changez-cette-cle-en-production

# ── Serveur ──────────────────────────────────────────────────────────
# Coolify injecte automatiquement le port de l'application.
# PORT=3000
# HOSTNAME=0.0.0.0
