# ── Base de données ──────────────────────────────────────────────────
# SQLite dans le volume persistant du conteneur (dossier /app/db).
# Dans Coolify : laissez cette valeur par défaut et montez un volume
# sur /app/db (voir README.md).
DATABASE_URL=file:/app/db/custom.db

# ── Serveur ──────────────────────────────────────────────────────────
# Coolify injecte automatiquement le port de l'application.
# PORT=3000
# HOSTNAME=0.0.0.0
