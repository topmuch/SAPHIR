// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String
  role         String   @default("admin")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Project {
  id          String    @id @default(cuid())
  reference   String    @unique
  nom         String
  client      String
  departement String
  statut      String    @default("en_attente")
  budget      Int       @default(0)
  progression Int       @default(0)
  dateDebut   DateTime?
  dateEcheance DateTime?
  responsable String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Client {
  id               String   @id @default(cuid())
  nom              String
  entreprise       String
  email            String
  telephone        String   @default("")
  tier             String   @default("nouveau")
  projetsActifs    Int      @default(0)
  revenuTotal      Int      @default(0)
  derniereActivite DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TeamMember {
  id         String   @id @default(cuid())
  nom        String
  role       String
  departement String
  email      String
  projets    Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
